# Groq (OpenAI-compatible). Required for extract / classify / rerank / Ask.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
GROQ_MATCH_MODEL=openai/gpt-oss-120b
GROQ_RERANK_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Dense embeddings (OpenAI-compatible). Required for hybrid recall + Ask.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Upload / processing limits
MAX_UPLOAD_MB=40
MAX_PAGES=500

# Local Tesseract OCR (no LLM tokens). Runs when pdf.js text is sparse.
OCR_ENABLED=true
OCR_MIN_TEXT_CHARS=40
OCR_RENDER_SCALE=2
OCR_MAX_PAGES=80
OCR_LANG=eng
OCR_CONCURRENCY=1

# Signal prior (page budget before chunk packing)
SIGNAL_MIN_SCORE=0.8

# Chunking / extract budget (structure-aware parent/child comes next; signal is a prior)
CHUNK_PAGES=8
CHUNK_CHAR_BUDGET=12000
MAX_EXTRACT_CHUNKS=16

# Hybrid recall → RRF → rerank → classify
MAX_MATCH_PAIRS=16
RERANK_TOP_N=30
RERANK_TOP_M=12
RERANK_MIN_SCORE=0.35
MATCH_BATCH_SIZE=6
CONFLICT_REVIEW_THRESHOLD=0.75

MAX_CONCURRENT_JOBS=1
# Keep at 1 on Groq free tier (TPM); raise only if you have higher limits.
MAX_CONCURRENT_EXTRACTIONS=1

# SQLite path (relative to project root)
DATABASE_PATH=data/factlayer.db
UPLOAD_DIR=data/uploads
