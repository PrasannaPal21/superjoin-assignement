# Groq (OpenAI-compatible). Required for extract / classify / rerank / Ask.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
GROQ_MATCH_MODEL=openai/gpt-oss-120b
GROQ_RERANK_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Dense embeddings — default is FREE local open-source (Transformers.js).
# First run downloads ~25MB ONNX weights into EMBEDDING_CACHE_DIR, then offline.
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/all-MiniLM-L6-v2
EMBEDDING_DIMENSIONS=384
EMBEDDING_BATCH_SIZE=16
EMBEDDING_CACHE_DIR=.cache/embeddings
# Optional paid/hosted OpenAI-compatible API (only if EMBEDDING_PROVIDER=http)
# EMBEDDING_API_KEY=
# EMBEDDING_BASE_URL=https://api.openai.com/v1


# Upload / processing limits
MAX_UPLOAD_MB=40
MAX_PAGES=500

# Local Tesseract OCR (no LLM tokens). Runs when pdf.js text is sparse.
OCR_ENABLED=true
OCR_MIN_TEXT_CHARS=40
OCR_RENDER_SCALE=2
OCR_MAX_PAGES=80
OCR_LANG=eng
OCR_CONCURRENCY=1

# Signal prior (page budget before chunk packing)
SIGNAL_MIN_SCORE=0.8

# Parent text cap / extract budget (parent–child hierarchy is the only chunk path)
CHUNK_CHAR_BUDGET=12000
# Cap how many child chunks are sent to Groq extract (by signal)
MAX_EXTRACT_CHUNKS=16

# Child chunk targets
CHILD_MIN_TOKENS=200
CHILD_MAX_TOKENS=800
CHILD_TABLE_ROWS=5

# Hybrid recall → RRF → rerank → classify
SPARSE_TOP_K=20
DENSE_TOP_K=20
RRF_K=60
RRF_TOP_N=30
MAX_MATCH_PAIRS=16
RERANK_TOP_N=30
RERANK_TOP_M=12
RERANK_MIN_SCORE=0.35
MATCH_BATCH_SIZE=6
CONFLICT_REVIEW_THRESHOLD=0.75

MAX_CONCURRENT_JOBS=1
# Keep at 1 on Groq free tier (TPM); raise only if you have higher limits.
MAX_CONCURRENT_EXTRACTIONS=1

# SQLite path (relative to project root)
DATABASE_PATH=data/factlayer.db
UPLOAD_DIR=data/uploads
