# Groq (OpenAI-compatible). Required for fact extraction.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_EXTRACT_MODEL=openai/gpt-oss-20b
GROQ_MATCH_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b

# Upload / processing limits
MAX_UPLOAD_MB=40
MAX_PAGES=500

# Cost/latency knobs (smart defaults)
CHUNK_PAGES=8
CHUNK_CHAR_BUDGET=12000
MAX_EXTRACT_CHUNKS=16
MAX_MATCH_PAIRS=16
MATCH_BATCH_SIZE=6
MAX_CONCURRENT_JOBS=1
MAX_CONCURRENT_EXTRACTIONS=4

# SQLite path (relative to project root)
DATABASE_PATH=data/factlayer.db
UPLOAD_DIR=data/uploads
